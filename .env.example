# ---------------------------------------------------------------------------
# Supabase — optional.
# Leave these blank and the app boots in DEMO MODE with a seeded in-memory
# dataset so every page/flow works in the browser with zero setup.
# Fill them in (Supabase dashboard → Project Settings → API) and the exact same
# code paths talk to Postgres + Supabase Auth instead.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for admin tasks (seeding, storage writes). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for auth redirects and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Anthropic — optional, and server-only. Powers the "Ask SitNext" assistant.
# With a key, the panel is a real Claude conversation with tools over this
# app's own data. Without one it falls back to retrieval-only answers and the
# panel says so, so the zero-setup demo still works.
# Get a key: https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
