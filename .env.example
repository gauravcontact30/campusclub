# ---------------------------------------------------------------------------
# Supabase — required for accounts, optional for everything else.
# Leave these blank and the app boots in DEMO MODE: the catalogue, search,
# meetup pages and the assistant all work off a seeded in-memory dataset, but
# sign-in and sign-up say the backend is not configured rather than minting a
# session that owns nothing. Anything behind an account is unreachable until
# you fill these in.
#
# Supabase dashboard → Project Settings → API. Use the PROJECT URL
# (https://<ref>.supabase.co), not the REST endpoint that sits beside it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for admin tasks (seeding, storage writes). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for auth redirects and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Anthropic — optional, and server-only. Powers the "Ask CampusClub" assistant.
# With a key, the panel is a real Claude conversation with tools over this
# app's own data. Without one it falls back to retrieval-only answers and the
# panel says so, so the zero-setup demo still works.
# Get a key: https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Razorpay — optional. Powers the join-fee and pass checkout.
# Without keys the app uses a clearly-labelled demo gateway: checkout completes
# and the join is recorded, but nothing is charged and the footer, the passes
# page and the assistant all say so. With keys, the identical flow opens a real
# Razorpay Checkout and the server verifies every signature before writing a join.
# Dashboard → Settings → API Keys, and Settings → Webhooks for the secret.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-only. Signs and verifies orders. Never expose to the browser.
RAZORPAY_KEY_SECRET=

# Server-only. Verifies webhook deliveries at /api/payments/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=

# Who can open /admin. Comma-separated, case-insensitive. Defaults to the
# owner's address when unset — see src/lib/admin/config.ts.
SUPER_ADMIN_EMAILS=
