# Copy to `.env.local` and fill in. `.env*.local` is gitignored; this file is
# not, so it must never hold a real key.
#
# The NEXT_PUBLIC_ prefixes are load-bearing, not decoration. Next.js only
# exposes prefixed variables to browser code, and `src/lib/env.ts` reads these
# exact names — a value set as SUPABASE_URL or SITE_URL is invisible to the app,
# which then silently falls back to the in-memory demo store with no error.

# --- Supabase (Project Settings → API) ---------------------------------------
# Without both of these the app runs on seeded demo data and sign-in is
# deliberately unavailable. See supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — bypasses row-level security. Never give it a NEXT_PUBLIC_
# prefix, and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- The site ----------------------------------------------------------------
# Used for absolute URLs (auth redirects, sitemap, Open Graph). On Vercel this
# falls back to the deployment URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated addresses that may reach /admin.
SUPER_ADMIN_EMAILS=

# --- Optional integrations ---------------------------------------------------
# Unset, the assistant answers from a scripted fallback and checkout completes
# as a demo payment. Both are supported states, not broken ones.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
